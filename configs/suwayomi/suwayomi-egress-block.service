[Unit]
Description=Pre-create Suwayomi egress drop (must exist before Docker starts)
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -N DOCKER-USER 2>/dev/null; /usr/sbin/iptables -C DOCKER-USER -s 172.30.50.0/24 -m conntrack --ctstate NEW -j DROP 2>/dev/null || /usr/sbin/iptables -I DOCKER-USER -s 172.30.50.0/24 -m conntrack --ctstate NEW -j DROP'
# No ExecStop on purpose: stopping this unit must never remove protection.

[Install]
RequiredBy=docker.service
