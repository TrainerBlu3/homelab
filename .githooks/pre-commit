#!/bin/sh
# pre-commit: block secrets, .env files, escaped Markdown. Prints file names only.
secret='BEGIN .*PRIVATE KEY|WIREGUARD_PRIVATE_KEY=[^<]|ntfy\.sh/'
local_patterns="$(git rev-parse --git-dir)/info/secret-patterns"
[ -f "$local_patterns" ] && secret="$secret|$(grep -v '^$' "$local_patterns" | paste -sd'|' -)"
escaped='^\\#|\\\*\\\*|^\\-'
fail=0
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in
    configs/powershell/profile.ps1|docs/lessons-learned.md|.githooks/*) continue ;;
    .env|*/.env) echo "ENV FILE     $f"; fail=1; continue ;;
  esac
  if git show ":$f" | grep -q -i -E "$secret"; then echo "SECRET?      $f"; fail=1; fi
  case "$f" in *.md)
    if git show ":$f" | grep -q -E "$escaped"; then echo "ESCAPED MD   $f"; fail=1; fi ;;
  esac
done
[ $fail -eq 0 ] || { echo "Commit blocked. Fix, git add, retry."; exit 1; }